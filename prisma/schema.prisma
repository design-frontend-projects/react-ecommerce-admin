  @@index([terminal_id])
  @@index([tenant_id, status])
}

// ============================================================================
// PROMOTIONS, DISCOUNTS & COUPONS MODULE — MODELS
// ============================================================================

model inv_promotions {
  id                    String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id             String                    @db.Uuid
  name                  String                    @db.VarChar(200)
  code                  String?                   @db.VarChar(50)
  description           String?
  status                inv_promotion_status_enum @default(draft)
  promo_type            inv_promotion_type_enum   @default(percentage)
  start_date            DateTime                  @db.Timestamptz(6)
  end_date              DateTime?                 @db.Timestamptz(6)
  timezone              String                    @default("Asia/Qatar") @db.VarChar(50)
  priority              Int                       @default(0)
  currency_id           String?                   @db.Uuid
  currency_code         String?                   @default("QAR") @db.VarChar(10)
  min_order_amount      Decimal?                  @default(0) @db.Decimal(18, 4)
  max_discount_amount   Decimal?                  @db.Decimal(18, 4)
  usage_limit           Int?
  usage_per_customer    Int?                      @default(1)
  daily_usage_limit     Int?
  current_usage_count   Int                       @default(0)
  allow_stacking        Boolean                   @default(false)
  stacking_priority     Int                       @default(0)
  max_stacking_count    Int?                      @default(1)
  requires_coupon       Boolean                   @default(false)
  requires_approval     Boolean                   @default(false)
  auto_apply            Boolean                   @default(true)
  scope_product_type    inv_promotion_scope_enum  @default(all)
  scope_customer_type   inv_promotion_scope_enum  @default(all)
  scope_channel_type    inv_promotion_scope_enum  @default(all)
  scope_location_type   inv_promotion_scope_enum  @default(all)
  created_by_user_id    String?                   @db.Uuid
  updated_by_user_id    String?                   @db.Uuid
  created_at            DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at            DateTime                  @default(now()) @db.Timestamptz(6)

  // Relations
  currencies            currencies?               @relation(fields: [currency_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  rules                 inv_promotion_rules[]
  conditions            inv_promotion_conditions[]
  products              inv_promotion_products[]
  categories            inv_promotion_categories[]
  brands                inv_promotion_brands[]
  customer_groups       inv_promotion_customer_groups[]
  channels              inv_promotion_channels[]
  stores                inv_promotion_stores[]
  branches              inv_promotion_branches[]
  coupons               inv_coupons[]
  coupon_redemptions    inv_coupon_redemptions[]
  invoice_discounts     inv_sales_invoice_discounts[]
  item_discounts        inv_sales_invoice_item_discounts[]
  usage_logs            inv_promotion_usage_logs[]

  @@index([tenant_id, status])
  @@index([tenant_id, start_date, end_date])
  @@index([tenant_id, code])
}


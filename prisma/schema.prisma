  sales_invoice_id   String?         @db.Uuid
  sales_order_id     String?         @db.Uuid
  customer_id        String?         @db.Uuid
  discount_amount    Decimal         @default(0) @db.Decimal(18, 4)
  channel_id         String?         @db.Uuid
  store_id           String?         @db.Uuid
  branch_id          String?         @db.Uuid
  used_at            DateTime        @default(now()) @db.Timestamptz(6)
  created_by_user_id String?         @db.Uuid

  // Relations
  promotion          inv_promotions  @relation(fields: [promotion_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sales_invoices     sales_invoices? @relation(fields: [sales_invoice_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  sales_orders       sales_orders?   @relation(fields: [sales_order_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  customers          customers?      @relation(fields: [customer_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  channels           channels?       @relation(fields: [channel_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  stores             stores?         @relation(fields: [store_id], references: [store_id], onDelete: SetNull, onUpdate: NoAction)
  branches           branches?       @relation(fields: [branch_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([promotion_id])
  @@index([tenant_id, customer_id])
  @@index([tenant_id, used_at])
}

// =============================================================================
// SALES INVOICE PAYMENTS
// =============================================================================

/// Individual payment records allocated to a sales invoice.
/// Supports split/mixed payments and links back to financial transactions.
model sales_invoice_payments {
  id                       String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id                String                   @db.Uuid
  invoice_id               String                   @db.Uuid
  payment_method           payment_method_type_enum @default(cash)
  amount                   Decimal                  @default(0) @db.Decimal(18, 4)
  currency                 String                   @default("USD") @db.Char(3)
  status                   payment_status_enum      @default(completed)
  reference_number         String?                  @db.VarChar(100)
  payment_date             DateTime                 @default(now()) @db.Timestamptz(6)
  notes                    String?
  financial_transaction_id String?                  @db.Uuid
  sales_order_payment_id   String?                  @db.Uuid
  created_at               DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at               DateTime                 @default(now()) @db.Timestamptz(6)
  created_by_user_id       String?                  @db.Uuid
  updated_by_user_id       String?                  @db.Uuid

  // Relations
  sales_invoices           sales_invoices           @relation(fields: [invoice_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([invoice_id], map: "idx_sales_inv_pay_invoice")
  @@index([tenant_id], map: "idx_sales_inv_pay_tenant")
  @@index([tenant_id, invoice_id], map: "idx_sales_inv_pay_tenant_inv")
}

// =============================================================================
// INVOICE NUMBER SEQUENCES
// =============================================================================

/// Tenant-aware, concurrency-safe invoice number sequences.
/// Supports per-tenant, per-store, per-fiscal-year numbering.
model invoice_number_sequences {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id       String   @db.Uuid
  store_id        String?  @db.Uuid
  prefix          String   @default("INV") @db.VarChar(20)
  fiscal_year     Int?
  last_number     Int      @default(0)
  format_template String   @default("{prefix}-{year}-{seq}") @db.VarChar(100)
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @db.Timestamptz(6)

  @@unique([tenant_id, store_id, prefix, fiscal_year], map: "uq_inv_num_seq_tenant")
  @@index([tenant_id], map: "idx_inv_num_seq_tenant")
}

model purchase_requisitions {
  id                          String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id                   String                  @db.Uuid
  requisition_number          String                  @default(dbgenerated("('PR-'::text || lpad((nextval('purchase_requisitions_seq'::regclass))::text, 6, '0'::text))")) @db.VarChar(30)
  branch_id                   String?                 @db.Uuid
  store_id                    String?                 @db.Uuid
  currency                    String?                 @default("USD") @db.Char(3)
  status                      requisition_status_enum @default(draft)
  source                      String                  @default("manual") @db.VarChar(20)
  requested_by                String?
  approved_by                 String?
  approved_at                 DateTime?               @db.Timestamptz(6)
  converted_purchase_order_id String?                 @db.Uuid
  needed_by                   DateTime?               @db.Date
  notes                       String?
  created_at                  DateTime                @default(now()) @db.Timestamptz(6)
  updated_at                  DateTime                @default(now()) @db.Timestamptz(6)
  created_by_user_id          String?                 @db.Uuid
  updated_by_user_id          String?                 @db.Uuid

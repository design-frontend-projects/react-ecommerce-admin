  updated_by_user_id String?                   @db.Uuid

  // Relations
  sales_order        sales_orders              @relation(fields: [sales_order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  session            pos_sessions?             @relation(fields: [session_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([sales_order_id])
  @@index([session_id])
  @@index([tenant_id])
}

/// Persistent suspended/held POS orders.
model pos_held_orders {
  id                 String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id          String                 @db.Uuid
  terminal_id        String                 @db.Uuid
  session_id         String                 @db.Uuid

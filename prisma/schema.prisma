model tenants {
  id                      String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_code             String                      @unique @db.VarChar(50)
  name                    String                      @db.VarChar(255)
  slug                    String                      @unique @db.VarChar(150)
  display_name            String?                     @db.VarChar(255)
  legal_name              String?                     @db.VarChar(255)
  type                    tenant_type                 @default(company)
  status                  tenant_status               @default(pending)
  logo_url                String?
  domain                  String?                     @db.VarChar(255)
  timezone                String                      @default("UTC") @db.VarChar(100)
  locale                  String                      @default("en-US") @db.VarChar(20)
  currency_code           String                      @default("LE") @db.Char(3)
  country_code            String?                     @db.VarChar(3)
  default_branch_id       String?                     @db.Uuid
  current_subscription_id String?                     @db.Uuid
  created_by              String?                     @db.Uuid
  created_at              DateTime                    @default(now()) @db.Timestamptz(6)
  updated_at              DateTime                    @default(now()) @db.Timestamptz(6)
  deleted_at              DateTime?                   @db.Timestamptz(6)
  metadata                Json                        @default("{}")
  country_id              String?                     @db.Uuid
  currency_id             String?                     @db.Uuid
  auth_user_id            String?                     @db.Uuid
  onboarding_complete     Boolean?                    @default(false)
  tenant_subscriptions    tenant_subscriptions[]      @relation("tenant_subscriptions_relation")
  subscription_usage      tenant_subscription_usage?
  subscription_invoices   subscription_invoices[]
  tenant_users            tenant_users[]
  countries               countries?                  @relation(fields: [country_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  currencies              currencies?                 @relation(fields: [currency_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  default_branch          branches?                   @relation("tenant_default_branch", fields: [default_branch_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([auth_user_id], map: "idx_tenants_auth_user_id")
}

model tenant_users {
  id                  String             @id(map: "users_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  auth_user_id        String?            @default(dbgenerated("auth.uid()")) @db.Uuid
  email               String?            @db.VarChar(255)
  phone               String?            @db.VarChar(20)
  first_name          String?            @db.VarChar(100)
  last_name           String?            @db.VarChar(100)
  avatar_url          String?
  primary_module      user_module?       @default(inventory)
  modules             user_module[]      @default([inventory])
  is_active           Boolean?           @default(true)
  created_at          DateTime?          @default(now()) @db.Timestamptz(6)
  updated_at          DateTime?          @default(now()) @db.Timestamptz(6)
  default_role        String?
  onboarding_complete Boolean            @default(false)
  is_restuarant_user  Boolean?           @default(false)
  parent_tenant_id    String?            @db.Uuid
  refund_pin_code     String?            @db.VarChar(255)
  id_number           String?
  tenant_id           String?            @db.Uuid
  branch_id           String?            @db.Uuid
  branches            branches?          @relation(fields: [branch_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tenants             tenants?           @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user_permissions    user_permissions[]
  user_roles          user_roles[]
}

/// Renamed from `transaction_details` → `financial_transaction_details` to avoid namespace collision with the Inventory Transaction Engine.
model financial_transaction_details {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id             String   @db.Uuid
  transaction_id        String   @db.Uuid
  quantity              Decimal  @db.Decimal(10, 2)
  unit_price            Decimal  @db.Decimal(10, 2)
  discount_amount       Decimal? @default(0) @db.Decimal(10, 2)
  tax_amount            Decimal? @default(0) @db.Decimal(10, 2)
  subtotal              Decimal  @db.Decimal(10, 2)
  sales_invoice_item_id String?  @db.Uuid
  sales_return_item_id  String?  @db.Uuid
  product_id            String   @db.Uuid
  created_by_user_id    String?  @db.Uuid
  updated_by_user_id    String?  @db.Uuid

  @@map("financial_transaction_details")
}

/// Renamed from `transactions` → `financial_transactions` to avoid namespace collision with the Inventory Transaction Engine.
model financial_transactions {
  id                       String                          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id                String                          @db.Uuid
  transaction_number       String                          @db.VarChar(50)
  transaction_type         financial_transaction_type_enum
  status                   String                          @default("pending") @db.VarChar(30)
  currency                 String                          @default("USD") @db.VarChar(10)
  subtotal                 Decimal                         @db.Decimal(12, 2)
  tax_amount               Decimal?                        @default(0) @db.Decimal(12, 2)
  discount_amount          Decimal?                        @default(0) @db.Decimal(12, 2)
  total_amount             Decimal                         @db.Decimal(12, 2)
  ip_address               String?                         @db.VarChar(45)
  user_agent               String?
  metadata                 Json?                           @default("{}")
  notes                    String?
  created_at               DateTime?                       @default(now()) @db.Timestamptz(6)
  updated_at               DateTime?                       @default(now()) @db.Timestamptz(6)
  reference_transaction_id String?                         @db.Uuid
  sales_invoice_id         String?                         @db.Uuid
  sales_return_id          String?                         @db.Uuid
  created_by_user_id       String?                         @db.Uuid
  updated_by_user_id       String?                         @db.Uuid

  @@map("financial_transactions")
}

model user_roles {
  role_id        String       @db.Uuid
  tenant_user_id String       @map("auth_user_id") @db.Uuid
  tenant_users   tenant_users @relation(fields: [tenant_user_id], references: [id], onDelete: Cascade)
  roles          roles        @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@id([tenant_user_id, role_id])
}

model business_activity_types {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                  String                  @unique @db.VarChar(50)
  name                  String                  @db.VarChar(100)
  description           String?                 @db.VarChar(255)
  is_active             Boolean                 @default(true)
  created_at            DateTime?               @default(now()) @db.Timestamptz(6)
  updated_at            DateTime?               @default(now()) @db.Timestamptz(6)
  module_activity_types module_activity_types[]
  tenant_activity_types tenant_activity_types[]
}

model tenant_activity_types {
  tenant_id               String                  @db.Uuid
  activity_type_id        String                  @db.Uuid
  is_active               Boolean                 @default(true)
  created_at              DateTime?               @default(now()) @db.Timestamptz(6)
  updated_at              DateTime?               @default(now()) @db.Timestamptz(6)
  business_activity_types business_activity_types @relation(fields: [activity_type_id], references: [id], onDelete: Cascade)

  @@id([tenant_id, activity_type_id])
}

model app_modules {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                  String                  @unique @db.VarChar(50)
  name                  String                  @db.VarChar(100)
  description           String?                 @db.VarChar(255)
  sort_order            Int                     @default(0)
  is_active             Boolean                 @default(true)
  created_at            DateTime?               @default(now()) @db.Timestamptz(6)
  updated_at            DateTime?               @default(now()) @db.Timestamptz(6)
  app_screens           app_screens[]
  module_activity_types module_activity_types[]
}

model module_activity_types {
  module_id               String                  @db.Uuid
  activity_type_id        String                  @db.Uuid
  created_at              DateTime?               @default(now()) @db.Timestamptz(6)
  business_activity_types business_activity_types @relation(fields: [activity_type_id], references: [id], onDelete: Cascade)
  app_modules             app_modules             @relation(fields: [module_id], references: [id], onDelete: Cascade)

  @@id([module_id, activity_type_id])
}

model app_screens {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code               String               @unique @db.VarChar(100)
  name               String               @db.VarChar(150)
  route              String               @unique @db.VarChar(255)
  description        String?              @db.VarChar(255)
  icon               String?              @db.VarChar(100)
  module_id          String               @db.Uuid
  sort_order         Int                  @default(0)
  is_active          Boolean              @default(true)
  is_system          Boolean              @default(false)
  created_at         DateTime?            @default(now()) @db.Timestamptz(6)
  updated_at         DateTime?            @default(now()) @db.Timestamptz(6)
  app_modules        app_modules          @relation(fields: [module_id], references: [id])
  screen_buttons     screen_buttons[]
  screen_permissions screen_permissions[]
  screen_roles       screen_roles[]
}

model screen_roles {
  screen_id   String      @db.Uuid
  role_id     String      @db.Uuid
  created_at  DateTime?   @default(now()) @db.Timestamptz(6)
  roles       roles       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  app_screens app_screens @relation(fields: [screen_id], references: [id], onDelete: Cascade)

  @@id([screen_id, role_id])
}

model screen_permissions {
  screen_id     String      @db.Uuid
  permission_id String      @db.Uuid
  created_at    DateTime?   @default(now()) @db.Timestamptz(6)
  permissions   permissions @relation(fields: [permission_id], references: [id], onDelete: Cascade)
  app_screens   app_screens @relation(fields: [screen_id], references: [id], onDelete: Cascade)

  @@id([screen_id, permission_id])
}

model permission_buttons {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code           String           @unique @db.VarChar(50)
  name           String           @db.VarChar(100)
  description    String?          @db.VarChar(255)
  is_system      Boolean          @default(false)
  created_at     DateTime?        @default(now()) @db.Timestamptz(6)
  updated_at     DateTime?        @default(now()) @db.Timestamptz(6)
  screen_buttons screen_buttons[]
}

model screen_buttons {
  screen_id          String             @db.Uuid
  button_id          String             @db.Uuid
  permission_id      String             @db.Uuid
  is_active          Boolean            @default(true)
  created_at         DateTime?          @default(now()) @db.Timestamptz(6)
  updated_at         DateTime?          @default(now()) @db.Timestamptz(6)
  permission_buttons permission_buttons @relation(fields: [button_id], references: [id], onDelete: Cascade)
  permissions        permissions        @relation(fields: [permission_id], references: [id], onDelete: Cascade)
  app_screens        app_screens        @relation(fields: [screen_id], references: [id], onDelete: Cascade)

  @@id([screen_id, button_id])
}

model user_permissions {
  tenant_user_id String       @db.Uuid
  permission_id  String       @db.Uuid
  is_granted     Boolean      @default(true)
  created_at     DateTime?    @default(now()) @db.Timestamptz(6)
  updated_at     DateTime?    @default(now()) @db.Timestamptz(6)
  permissions    permissions  @relation(fields: [permission_id], references: [id], onDelete: Cascade)
  tenant_users   tenant_users @relation(fields: [tenant_user_id], references: [id], onDelete: Cascade)

  @@id([tenant_user_id, permission_id])
}

model rbac_audit {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actor_auth_user_id String?  @db.Uuid
  tenant_id          String?  @db.Uuid
  action             String   @db.VarChar(100)
  target_type        String   @db.VarChar(100)
  target_id          String   @db.VarChar(255)
  diff               Json?
  created_at         DateTime @default(now()) @db.Timestamptz(6)

  @@index([created_at(sort: Desc)], map: "idx_rbac_audit_created_at")
  @@index([target_type, target_id], map: "idx_rbac_audit_target")
  @@index([tenant_id, created_at(sort: Desc)], map: "idx_rbac_audit_tenant_created")
}

model inventory_movements {
  id                         String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  movement_no                BigInt?
  branch_id                  String?              @db.Uuid
  store_id                   String?              @db.Uuid
  warehouse_id               String?              @db.Uuid
  location_id                String?              @db.Uuid
  warehouse_location_id      String?              @db.Uuid
  product_variant_id         String               @db.Uuid
  movement_type              movement_type_enum
  status                     movement_status_enum @default(posted)
  condition                  stock_condition_enum @default(good)
  quantity_delta             Decimal              @db.Decimal(18, 4)
  unit_cost                  Decimal              @default(0) @db.Decimal(18, 4)
  total_cost                 Decimal              @default(0) @db.Decimal(18, 4)
  reference_type             String?              @db.VarChar(100)
  reference_id               String?              @db.Uuid
  occurred_at                DateTime             @default(now()) @db.Timestamptz(6)
  movement_date              DateTime             @default(now()) @db.Timestamptz(6)
  batch_id                   String?              @db.Uuid
  serial_id                  String?              @db.Uuid
  reversed_movement_id       String?              @db.Uuid
  dest_store_id              String?              @db.Uuid
  dest_warehouse_location_id String?              @db.Uuid
  idempotency_key            String?
  movement_group_id          String?              @db.Uuid
  qty_after                  Decimal?             @db.Decimal(18, 4)
  qty_before                 Decimal?             @db.Decimal(18, 4)
  reason_code                String?              @db.VarChar(40)
  source_document_id         String?              @db.Uuid
  source_document_type       String?              @db.VarChar(40)
  remarks                    String?
  notes                      String?
  created_by                 String?
  created_at                 DateTime             @default(now()) @db.Timestamptz(6)
  tenant_id                  String               @db.Uuid
  created_by_user_id         String?              @db.Uuid
  updated_by_user_id         String?              @db.Uuid
}

model stock_balances {
  id                    String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id             String               @db.Uuid
  warehouse_id          String?              @db.Uuid
  location_id           String?              @db.Uuid
  store_id              String?              @db.Uuid
  product_variant_id    String               @db.Uuid
  condition             stock_condition_enum @default(good)
  batch_id              String?              @db.Uuid
  serial_id             String?              @db.Uuid
  qty_on_hand           Decimal              @default(0) @db.Decimal(18, 4)
  qty_reserved          Decimal              @default(0) @db.Decimal(18, 4)
  qty_available         Decimal?             @db.Decimal(18, 4)
  qty_in_transit        Decimal              @default(0) @db.Decimal(18, 4)
  qty_incoming          Decimal              @default(0) @db.Decimal(18, 4)
  qty_outgoing          Decimal              @default(0) @db.Decimal(18, 4)
  qty_damaged           Decimal              @default(0) @db.Decimal(18, 4)
  avg_cost              Decimal              @default(0) @db.Decimal(18, 4)
  last_movement_at      DateTime?            @db.Timestamptz(6)
  last_transaction_id   String?              @db.Uuid
  last_transaction_at   DateTime?            @db.Timestamptz(6)
  version               Int                  @default(0)
  created_at            DateTime             @default(now()) @db.Timestamptz(6)
  updated_at            DateTime             @default(now()) @db.Timestamptz(6)
  created_by_user_id    String?              @db.Uuid
  updated_by_user_id    String?              @db.Uuid
  product_variants      product_variants     @relation(fields: [product_variant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  warehouses            warehouses?          @relation(fields: [warehouse_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  stores                stores?              @relation(fields: [store_id], references: [store_id], onDelete: Cascade, onUpdate: NoAction)
  warehouse_locations   warehouse_locations? @relation(fields: [location_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  inventory_transaction_items inventory_transaction_items[]
  stock_reservations    stock_reservations[]

  @@index([tenant_id, product_variant_id], map: "idx_stock_balance_variant")
  @@index([tenant_id, warehouse_id], map: "idx_stock_balance_warehouse")
  @@index([tenant_id, product_variant_id, warehouse_id, condition], map: "idx_stock_balance_lookup")
  @@index([tenant_id, store_id], map: "idx_stock_balance_store")
  @@index([batch_id], map: "idx_stock_balance_batch")
}


model stock_transfers {
  id                       String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id                String               @db.Uuid
  transfer_no              BigInt?
  source_warehouse_id      String?              @db.Uuid
  destination_warehouse_id String?              @db.Uuid
  from_store_id            String?              @db.Uuid
  to_store_id              String?              @db.Uuid
  from_branch_id           String?              @db.Uuid
  to_branch_id             String?              @db.Uuid
  status                   transfer_status_enum @default(draft)
  reference_no             String?              @db.VarChar(50)
  notes                    String?
  created_by               String?
  shipped_by               String?
  received_by              String?
  approved_by              String?
  approved_at              DateTime?            @db.Timestamptz(6)
  shipped_at               DateTime?            @db.Timestamptz(6)
  received_at              DateTime?            @db.Timestamptz(6)
  created_at               DateTime             @default(now()) @db.Timestamptz(6)
  updated_at               DateTime             @default(now()) @db.Timestamptz(6)
  created_by_user_id       String?              @db.Uuid
  updated_by_user_id       String?              @db.Uuid
  source_warehouse         warehouses?          @relation("transfer_source_warehouse", fields: [source_warehouse_id], references: [id], onUpdate: NoAction)
  destination_warehouse    warehouses?          @relation("transfer_destination_warehouse", fields: [destination_warehouse_id], references: [id], onUpdate: NoAction)
}

model stock_transfer_items {
  id                      String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id               String?              @db.Uuid
  stock_transfer_id       String               @db.Uuid
  product_variant_id      String               @db.Uuid
  source_location_id      String?              @db.Uuid
  destination_location_id String?              @db.Uuid
  qty                     Decimal              @db.Decimal(18, 4)
  received_qty            Decimal              @default(0) @db.Decimal(18, 4)
  unit_cost               Decimal              @default(0) @db.Decimal(18, 4)
  condition               stock_condition_enum @default(good)
  batch_id                String?              @db.Uuid
  serial_id               String?              @db.Uuid
  created_at              DateTime             @default(now()) @db.Timestamptz(6)
  created_by_user_id      String?              @db.Uuid
  updated_by_user_id      String?              @db.Uuid
}

model stock_adjustments {

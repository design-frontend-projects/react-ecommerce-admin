generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model activity_types {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String    @db.VarChar(50)
  name        String    @db.VarChar(100)
  description String?
  is_active   Boolean   @default(true)
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model audit_logs {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  activity_type_id String    @db.Uuid
  action           String    @db.VarChar(255)
  entity_type      String    @db.VarChar(100)
  entity_id        String    @db.VarChar(100)
  old_values       Json?
  new_values       Json?
  metadata         Json?
  ip_address       String?   @db.VarChar(45)
  user_agent       String?
  created_at       DateTime? @default(now()) @db.Timestamptz(6)
  user_id          String?   @db.Uuid
}

model addresses {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id          String    @db.Uuid
  address_type       String?   @default("billing") @db.VarChar(30)
  address_type_id    String?   @db.Uuid
  line1              String?   @db.VarChar(255)
  line2              String?   @db.VarChar(255)
  city               String?   @db.VarChar(100)
  state              String?   @db.VarChar(100)
  postal_code        String?   @db.VarChar(20)
  country            String?   @db.VarChar(100)
  country_id         String?   @db.Uuid
  latitude           Decimal?  @db.Decimal
  longitude          Decimal?  @db.Decimal
  is_default         Boolean?  @default(false)
  created_at         DateTime? @default(now()) @db.Timestamptz(6)
  updated_at         DateTime? @default(now()) @db.Timestamptz(6)
  created_by_user_id String?   @db.Uuid
  updated_by_user_id String?   @db.Uuid
}

model branches {
  id                  String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String         @db.VarChar(200)
  city_id             String         @db.Uuid
  address             String?
  phone               String?        @db.VarChar(20)
  email               String?        @db.VarChar(255)
  is_active           Boolean?       @default(true)
  created_at          DateTime?      @default(now()) @db.Timestamptz(6)
  updated_at          DateTime?      @default(now()) @db.Timestamptz(6)
  tenant_id           String         @db.Uuid
  created_by_user_id  String?        @db.Uuid
  updated_by_user_id  String?        @db.Uuid
  cities              cities         @relation(fields: [city_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  stores              stores[]
  tenant_users        tenant_users[]
  default_for_tenants tenants[]      @relation("tenant_default_branch")
  warehouses          warehouses[]
  purchase_requisitions purchase_requisitions[]
  pos_terminals       pos_terminals[]
  inv_promotion_branches inv_promotion_branches[]
  inv_promotion_usage_logs inv_promotion_usage_logs[]
  inv_discount_approval_requests inv_discount_approval_requests[]
}

model categories {
  name               String        @db.VarChar(100)
  name_ar            String?       @db.VarChar(150)
  description        String?
  created_at         DateTime?     @default(now()) @db.Timestamptz(6)
  is_active          Boolean?      @default(true)
  deleted_at         DateTime?     @db.Timestamptz(6)
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id          String?       @db.Uuid
  created_by_user_id String?       @db.Uuid
  updated_by_user_id String?       @db.Uuid
  parent_id          String?       @db.Uuid
  parent             categories?   @relation("CategoryHierarchy", fields: [parent_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  children           categories[]  @relation("CategoryHierarchy")
  products           products[]
  inv_promotion_categories inv_promotion_categories[]
}

model cities {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String      @db.VarChar(100)
  country_id String      @db.Uuid
  is_active  Boolean?    @default(true)
  created_at DateTime?   @default(now()) @db.Timestamptz(6)
  updated_at DateTime?   @default(now()) @db.Timestamptz(6)
  branches   branches[]
  countries  countries   @relation(fields: [country_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  stores     stores[]
  suppliers  suppliers[]
  warehouses warehouses[]
}

model countries {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String      @db.VarChar(100)
  code        String      @db.VarChar(3)
  phone_code  String?     @db.VarChar(10)
  is_active   Boolean?    @default(true)
  created_at  DateTime?   @default(now()) @db.Timestamptz(6)
  updated_at  DateTime?   @default(now()) @db.Timestamptz(6)
  currency_id String?     @db.Uuid
  cities      cities[]
  currencies  currencies? @relation(fields: [currency_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  stores      stores[]
  tax_rates   tax_rates[]
  tenants     tenants[]
  warehouses  warehouses[]
}

model currencies {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String      @db.VarChar(100)
  name_ar    String?     @db.VarChar(100)
  code       String      @unique @db.VarChar(3)
  symbol     String      @db.VarChar(10)
  is_active  Boolean?    @default(true)
  created_at DateTime?   @default(now()) @db.Timestamptz(6)
  updated_at DateTime?   @default(now()) @db.Timestamptz(6)
  countries  countries[]
  tenants    tenants[]
  price_list       price_list[]
  sales_invoices   sales_invoices[]
  purchase_orders purchase_orders[]
  inv_promotions inv_promotions[]
}

model customer_cards {
  card_type          String?   @db.VarChar(20)
  last_four_digits   String    @db.Char(4)
  expiry_month       Int       @db.SmallInt
  expiry_year        Int       @db.SmallInt
  cardholder_name    String    @db.VarChar(200)
  billing_address    String?
  is_default         Boolean?  @default(false)
  tokenized_id       String?   @db.VarChar(100)
  added_at           DateTime? @default(now()) @db.Timestamptz(6)
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id          String    @db.Uuid
  customer_id        String    @db.Uuid
  created_by_user_id String?   @db.Uuid
  updated_by_user_id String?   @db.Uuid
  customers          customers @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_customer_cards_customers")
}

model customer_groups {
  name                 String      @db.VarChar(100)
  description          String?
  minimum_order_amount Decimal?    @default(0) @db.Decimal(10, 2)
  discount_percentage  Decimal?    @default(0) @db.Decimal(5, 2)
  created_at           DateTime?   @default(now()) @db.Timestamptz(6)
  id                   String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id            String      @db.Uuid
  created_by_user_id   String?     @db.Uuid
  updated_by_user_id   String?     @db.Uuid
  customers            customers[]
  price_list           price_list[]
  price_list_assignments price_list_assignments[]
  inv_promotion_customer_groups inv_promotion_customer_groups[]
}

model customers {
  first_name         String           @db.VarChar(100)
  last_name          String           @db.VarChar(100)
  code               String?          @db.VarChar(30)
  customer_type_id   String?          @db.Uuid
  email              String?          @db.VarChar(200)
  phone              String?          @db.VarChar(50)
  address_line1      String?          @db.VarChar(200)
  address_line2      String?          @db.VarChar(200)
  city               String?          @db.VarChar(100)
  state              String?          @db.VarChar(100)
  postal_code        String?          @db.VarChar(20)
  country            String?          @default("USA") @db.VarChar(100)
  date_of_birth      DateTime?        @db.Date
  loyalty_points     Int?             @default(0)
  is_active          Boolean?         @default(true)
  created_at         DateTime?        @default(now()) @db.Timestamptz(6)
  updated_at         DateTime?        @default(now()) @db.Timestamptz(6)
  deleted_at         DateTime?        @db.Timestamptz(6)
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id          String           @db.Uuid
  group_id           String?          @db.Uuid
  created_by_user_id String?          @db.Uuid
  updated_by_user_id String?          @db.Uuid
  customer_cards     customer_cards[]
  customer_groups    customer_groups? @relation(fields: [group_id], references: [id], onUpdate: NoAction, map: "fk_customers_customer_groups")
  sales_invoices         sales_invoices[]
  inv_coupons            inv_coupons[]
  inv_coupon_redemptions inv_coupon_redemptions[]
  inv_promotion_usage_logs inv_promotion_usage_logs[]
}

model payment_types {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String
  is_enabled         Boolean   @default(true)
  created_at         DateTime? @default(now()) @db.Timestamptz(6)
  updated_at         DateTime? @default(now()) @db.Timestamptz(6)
  tenant_id          String    @db.Uuid
  created_by_user_id String?   @db.Uuid
  updated_by_user_id String?   @db.Uuid
}

model permissions {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String               @unique @db.VarChar(100)
  description        String?              @db.VarChar(255)
  created_at         DateTime?            @default(now()) @db.Timestamptz(6)
  updated_at         DateTime?            @default(now()) @db.Timestamptz(6)
  action             String?              @db.VarChar(50)
  resource           String?              @db.VarChar(100)
  role_permissions   role_permissions[]
  screen_buttons     screen_buttons[]
  screen_permissions screen_permissions[]
  user_permissions   user_permissions[]
}

model pos_terminals {
  id                     String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  store_id               String?       @db.Uuid
  branch_id              String?       @db.Uuid
  warehouse_id           String?       @db.Uuid
  default_price_list_id  String?       @db.Uuid
  name                   String        @db.VarChar(150)
  code                   String        @db.VarChar(100)
  device_identifier      String?       @db.VarChar(255)
  receipt_printer_name   String?       @db.VarChar(255)
  status                 record_status @default(active)
  deleted_at             DateTime?     @db.Timestamptz(6)
  created_at             DateTime      @default(now()) @db.Timestamptz(6)
  updated_at             DateTime      @default(now()) @db.Timestamptz(6)
  tenant_id              String        @db.Uuid
  created_by_user_id     String?       @db.Uuid
  updated_by_user_id     String?       @db.Uuid

  // Relations
  branches               branches?     @relation(fields: [branch_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  warehouses             warehouses?   @relation(fields: [warehouse_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  default_price_list     price_list?   @relation(fields: [default_price_list_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  pos_terminal_users     pos_terminal_users[]
  pos_sessions           pos_sessions[]
  pos_held_orders        pos_held_orders[]
  sales_orders           sales_orders[]
  inv_discount_approval_requests inv_discount_approval_requests[]

  @@index([tenant_id])
  @@index([store_id])
  @@index([branch_id])
}

model price_list {
  name               String?             @db.VarChar(150)
  code               String?             @db.VarChar(50)
  is_default         Boolean             @default(false)
  price              Decimal?            @db.Decimal(10, 2)
  start_date         DateTime            @default(dbgenerated("CURRENT_DATE")) @db.Date
  end_date           DateTime?           @db.Date
  is_active          Boolean?            @default(true)
  description        String?
  type               price_list_types?
  price_list_type_id String?             @db.Uuid
  store_id           String?             @db.Uuid
  currency_id        String?             @db.Uuid
  channel_id         String?             @db.Uuid
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id          String              @db.Uuid
  product_id         String?             @db.Uuid
  group_id           String?             @db.Uuid
  created_at         DateTime?           @default(now()) @db.Timestamptz(6)
  updated_at         DateTime?           @default(now()) @db.Timestamptz(6)
  created_by_user_id String?             @db.Uuid
  updated_by_user_id String?             @db.Uuid
  products           products?           @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  customer_groups    customer_groups?    @relation(fields: [group_id], references: [id], onUpdate: NoAction)
  stores             stores?             @relation(fields: [store_id], references: [store_id], onUpdate: NoAction)
  currencies         currencies?         @relation(fields: [currency_id], references: [id], onUpdate: NoAction)
  channels           channels?           @relation(fields: [channel_id], references: [id], onUpdate: NoAction)
  price_list_items   price_list_items[]
  price_list_assignments price_list_assignments[]
  pos_terminals      pos_terminals[]
}

model price_list_items {
  id                   String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_variant_id   String           @db.Uuid
  product_id           String?          @db.Uuid
  price                Decimal          @db.Decimal(18, 4)
  cost_price           Decimal?         @default(0) @db.Decimal(18, 4)
  min_price            Decimal          @default(0) @db.Decimal(18, 4)
  max_discount_percent Decimal          @default(0) @db.Decimal(7, 4)
  created_at           DateTime         @default(now()) @db.Timestamptz(6)
  updated_at           DateTime         @default(now()) @db.Timestamptz(6)
  tenant_id            String           @db.Uuid
  price_list_id        String           @db.Uuid
  created_by_user_id   String?          @db.Uuid
  updated_by_user_id   String?          @db.Uuid
  price_list           price_list       @relation(fields: [price_list_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product_variants     product_variants @relation(fields: [product_variant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products             products?        @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([price_list_id, product_variant_id])
}

model price_list_assignments {
  id                 String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id          String                      @db.Uuid
  price_list_id      String                      @db.Uuid
  store_id           String?                     @db.Uuid
  channel_id         String?                     @db.Uuid
  customer_group_id  String?                     @db.Uuid
  assignment_type    price_list_assignment_type  @default(STORE)
  priority           Int                         @default(100)
  is_default         Boolean                     @default(false)
  is_active          Boolean                     @default(true)
  valid_from         DateTime?                   @db.Timestamptz(6)
  valid_to           DateTime?                   @db.Timestamptz(6)
  created_at         DateTime                    @default(now()) @db.Timestamptz(6)
  created_by_user_id String?                     @db.Uuid
  updated_at         DateTime                    @default(now()) @db.Timestamptz(6)
  updated_by_user_id String?                     @db.Uuid
  deleted_at         DateTime?                   @db.Timestamptz(6)
  deleted_by_user_id String?                     @db.Uuid

  price_list         price_list                  @relation(fields: [price_list_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  stores             stores?                     @relation(fields: [store_id], references: [store_id], onDelete: Cascade, onUpdate: NoAction)
  channels           channels?                   @relation(fields: [channel_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  customer_groups    customer_groups?            @relation(fields: [customer_group_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenant_id])
  @@index([price_list_id])
  @@index([tenant_id, store_id])
  @@index([tenant_id, channel_id])
  @@index([tenant_id, customer_group_id])
  @@index([tenant_id, is_active, priority])
}


model product_variants {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id            String                 @db.Uuid
  sku                  String                 @db.VarChar(100)
  barcode              String?                @db.VarChar(100)
  name                 String?                @db.VarChar(200)
  weight               Decimal?               @db.Decimal(10, 2)
  dimensions           Json?
  is_active            Boolean?               @default(true)
  created_at           DateTime?              @default(now()) @db.Timestamptz(6)
  updated_at           DateTime?              @default(now()) @db.Timestamptz(6)
  uom_id               String?                @db.Uuid
  product_id           String                 @db.Uuid
  created_by_user_id   String?                @db.Uuid
  updated_by_user_id   String?                @db.Uuid
  pos_reorder_requests pos_reorder_requests[]
  products             products               @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_product_variants_products")
  purchase_order_items purchase_order_items[]
  reorder_rules        reorder_rules[]
  reorder_suggestions  reorder_suggestions[]
  inventory            inventory[]
  stock_balances       stock_balances[]
  stock_by_location    stock_by_location[]
  price_list_items     price_list_items[]
  purchase_requisition_items purchase_requisition_items[]
  inventory_transaction_items inventory_transaction_items[]
  inv_promotion_products inv_promotion_products[]
  inv_promotion_rules_free inv_promotion_rules[] @relation("inv_free_variant")
}


model products {
  name                   String                 @db.VarChar(200)
  description            String?
  sku                    String                 @db.VarChar(50)
  barcode                String?                @db.VarChar(100)
  weight                 Decimal?               @db.Decimal(8, 2)
  dimensions             String?                @db.VarChar(50)
  is_active              Boolean?               @default(true)
  created_at             DateTime?              @default(now()) @db.Timestamptz(6)
  updated_at             DateTime?              @default(now()) @db.Timestamptz(6)
  reorder_level          Decimal?               @db.Decimal
  product_name_embedding Unsupported("vector")?
  store_id               String?
  has_variants           Boolean?               @default(false)
  is_deleted             Boolean?               @default(false)
  has_expiration         Boolean?               @default(false)
  expiration_date        DateTime?              @db.Date
  is_marketplace         Boolean?               @default(false)
  base_uom_id            String?                @db.Uuid
  brand_id               String?                @db.Uuid
  tracking_mode          tracking_mode_enum     @default(none)
  is_stock_item          Boolean?               @default(true)
  reorderable            Boolean?               @default(true)
  tax_code               String?
  tax_classification_id  String?                @db.Uuid
  is_batch_tracked       Boolean                @default(false)
  is_serial_tracked      Boolean                @default(false)
  product_type           product_type_enum      @default(simple)
  product_type_id        String?                @db.Uuid
  deleted_at             DateTime?              @db.Timestamptz(6)
  id                     String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id              String                 @db.Uuid
  supplier_id            String?                @db.Uuid
  category_id            String?                @db.Uuid
  created_by_user_id     String?                @db.Uuid
  updated_by_user_id     String?                @db.Uuid
  pos_reorder_requests   pos_reorder_requests[]
  product_variants       product_variants[]
  base_uom               uoms?                  @relation(fields: [base_uom_id], references: [id], onUpdate: NoAction)
  brands                 brands?                @relation(fields: [brand_id], references: [id], onUpdate: NoAction)
  categories             categories?            @relation(fields: [category_id], references: [id], onUpdate: NoAction)
  product_types          product_types?         @relation(fields: [product_type_id], references: [id], onUpdate: NoAction)
  suppliers              suppliers?             @relation(fields: [supplier_id], references: [id], onUpdate: NoAction)
  purchase_order_items   purchase_order_items[]
  inventory              inventory[]
  price_list             price_list[]
  price_list_items       price_list_items[]
  inv_promotion_products inv_promotion_products[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model product_types {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String     @unique @db.VarChar(50)
  name        String     @db.VarChar(100)
  name_ar     String?    @db.VarChar(100)
  description String?
  icon        String?    @db.VarChar(50)
  color       String?    @db.VarChar(20)
  sort_order  Int?       @default(1)
  is_active   Boolean?   @default(true)
  created_at  DateTime?  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime?  @default(now()) @db.Timestamptz(6)
  products    products[]
}

model inventory {
  inventory_id          Int                  @id @default(autoincrement())
  store_id              String?              @db.Uuid
  warehouse_id          String?              @db.Uuid
  warehouse_location_id String?              @db.Uuid
  created_at            DateTime?            @default(now()) @db.Timestamptz(6)
  last_count_date       DateTime?            @db.Timestamptz(6)
  last_restocked_date   DateTime?            @db.Timestamptz(6)
  max_quantity          Int?
  min_quantity          Int?                 @default(0)
  reorder_point         Int?                 @default(0)
  safety_stock          Int?                 @default(0)
  reorder_quantity      Int?                 @default(0)
  reorder_level         Int?                 @default(0)
  unit_cost             Decimal?             @db.Decimal(18, 4)
  lead_time_days        Int?                 @default(1)
  is_active             Boolean              @default(true)
  status                String?              @default("active") @db.VarChar(50)
  aisle                 String?              @db.VarChar(50)
  rack                  String?              @db.VarChar(50)
  shelf                 String?              @db.VarChar(50)
  bin                   String?              @db.VarChar(50)
  notes                 String?
  tenant_id             String               @db.Uuid
  updated_at            DateTime?            @default(now()) @db.Timestamptz(6)
  product_id            String?              @db.Uuid
  product_variant_id    String?              @db.Uuid
  created_by_user_id    String?              @db.Uuid
  updated_by_user_id    String?              @db.Uuid
  products              products?            @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product_variants      product_variants?    @relation(fields: [product_variant_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  stores                stores?              @relation(fields: [store_id], references: [store_id], onDelete: SetNull, onUpdate: NoAction)
  warehouses            warehouses?          @relation(fields: [warehouse_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  warehouse_locations   warehouse_locations? @relation(fields: [warehouse_location_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([tenant_id])
  @@index([store_id])
  @@index([warehouse_id])
  @@index([warehouse_location_id])
  @@index([product_id])
  @@index([product_variant_id])
  @@index([tenant_id, store_id, warehouse_id])
  @@index([tenant_id, product_id, product_variant_id])
}

model pos_reorder_requests {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

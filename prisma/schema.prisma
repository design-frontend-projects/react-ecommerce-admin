  warehouse_location_id String?   @db.Uuid
  batch_id              String?   @db.Uuid
  serial_id             String?   @db.Uuid
  qty_snapshot          Decimal   @default(0) @db.Decimal(18, 4)
  qty_counted           Decimal?  @db.Decimal(18, 4)

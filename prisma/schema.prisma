/// Reference/config table defining all possible inventory transaction types and their stock effects.
model inventory_transaction_types {
  id                    String                              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id             String?                             @db.Uuid
  code                  String                              @db.VarChar(50)
  name                  String                              @db.VarChar(100)
  description           String?
  direction             inventory_transaction_direction_enum
  category              inventory_transaction_category_enum
  requires_approval     Boolean                             @default(false)
  requires_destination  Boolean                             @default(false)
  allows_negative_stock Boolean                             @default(false)
  auto_post             Boolean                             @default(false)
  is_system             Boolean                             @default(true)
  is_active             Boolean                             @default(true)
  sort_order            Int                                 @default(0)
  created_at            DateTime                            @default(now()) @db.Timestamptz(6)
  updated_at            DateTime                            @default(now()) @db.Timestamptz(6)

  // Relations
  rules                 inventory_transaction_type_rules[]
  transactions          inventory_transactions[]

  @@unique([code], map: "uq_inv_txn_type_code")
  @@index([category], map: "idx_inv_txn_type_category")
}

/// Rule engine: defines HOW each transaction type affects each stock quantity field.
model inventory_transaction_type_rules {
  id                    String                              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transaction_type_id   String                              @db.Uuid
  stock_field           stock_field_enum
  operation             stock_operation_enum
  applies_to            stock_rule_applies_to_enum          @default(SOURCE)
  description           String?
  sort_order            Int                                 @default(0)
  created_at            DateTime                            @default(now()) @db.Timestamptz(6)

  // Relations
  transaction_type      inventory_transaction_types         @relation(fields: [transaction_type_id], references: [id], onDelete: Cascade)

  @@unique([transaction_type_id, stock_field, applies_to], map: "uq_inv_txn_type_rule")
  @@index([transaction_type_id], map: "idx_inv_txn_type_rule_type")
}

/// Central inventory state-changing event header. Every stock mutation flows through this table.
model inventory_transactions {
  id                        String                              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id                 String                              @db.Uuid
  transaction_number        String                              @db.VarChar(50)
  type_id                   String                              @db.Uuid
  status                    inventory_transaction_status_enum   @default(draft)
  direction                 inventory_transaction_direction_enum

  // Location context
  source_warehouse_id       String?                             @db.Uuid
  source_store_id           String?                             @db.Uuid
  source_location_id        String?                             @db.Uuid
  dest_warehouse_id         String?                             @db.Uuid
  dest_store_id             String?                             @db.Uuid
  dest_location_id          String?                             @db.Uuid

  // Source document reference (polymorphic)
  reference_type            String?                             @db.VarChar(60)
  reference_id              String?                             @db.Uuid

  // Financial summary
  total_qty                 Decimal                             @default(0) @db.Decimal(18, 4)
  total_cost                Decimal                             @default(0) @db.Decimal(18, 4)
  currency                  String                              @default("USD") @db.VarChar(10)

  // Approval chain
  submitted_by              String?                             @db.Uuid
  submitted_at              DateTime?                           @db.Timestamptz(6)
  approved_by               String?                             @db.Uuid
  approved_at               DateTime?                           @db.Timestamptz(6)
  posted_by                 String?                             @db.Uuid
  posted_at                 DateTime?                           @db.Timestamptz(6)
  cancelled_by              String?                             @db.Uuid
  cancelled_at              DateTime?                           @db.Timestamptz(6)

  // Reversal linkage
  reversed_by_transaction_id String?                            @db.Uuid
  reversal_of_transaction_id String?                            @db.Uuid

  // Metadata
  notes                     String?
  metadata                  Json?                               @default("{}")
  idempotency_key           String?                             @db.VarChar(128)
  version                   Int                                 @default(0)

  created_at                DateTime                            @default(now()) @db.Timestamptz(6)
  updated_at                DateTime                            @default(now()) @db.Timestamptz(6)
  created_by_user_id        String?                             @db.Uuid
  updated_by_user_id        String?                             @db.Uuid

  // Relations
  transaction_type          inventory_transaction_types         @relation(fields: [type_id], references: [id])
  items                     inventory_transaction_items[]
  audit_logs                inventory_audit_logs[]

  @@unique([tenant_id, transaction_number], map: "uq_inv_txn_number")
  @@unique([idempotency_key], map: "uq_inv_txn_idempotency")
  @@index([tenant_id, status], map: "idx_inv_txn_tenant_status")
  @@index([tenant_id, type_id], map: "idx_inv_txn_tenant_type")
  @@index([tenant_id, created_at(sort: Desc)], map: "idx_inv_txn_tenant_created")
  @@index([reference_type, reference_id], map: "idx_inv_txn_reference")
  @@index([source_warehouse_id], map: "idx_inv_txn_source_wh")
  @@index([dest_warehouse_id], map: "idx_inv_txn_dest_wh")
}

/// Individual line items within an inventory transaction.
model inventory_transaction_items {
  id                    String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id             String                   @db.Uuid
  transaction_id        String                   @db.Uuid
  product_variant_id    String                   @db.Uuid
  stock_balance_id      String?                  @db.Uuid

  // Quantity & cost (always positive; direction determined by parent transaction)
  quantity              Decimal                  @db.Decimal(18, 4)
  unit_cost             Decimal                  @default(0) @db.Decimal(18, 4)
  total_cost            Decimal                  @default(0) @db.Decimal(18, 4)

  // Snapshot fields (for auditability — captured at transaction time)
  sku_snapshot          String?                  @db.VarChar(100)
  product_name_snapshot String?                  @db.VarChar(255)
  uom_snapshot          String?                  @db.VarChar(30)

  // Location overrides (when items go to different locations within a transaction)
  source_warehouse_id   String?                  @db.Uuid
  source_store_id       String?                  @db.Uuid
  source_location_id    String?                  @db.Uuid
  dest_warehouse_id     String?                  @db.Uuid
  dest_store_id         String?                  @db.Uuid
  dest_location_id      String?                  @db.Uuid

  // Tracking
  batch_id              String?                  @db.Uuid
  serial_id             String?                  @db.Uuid
  lot_number            String?                  @db.VarChar(80)
  serial_number         String?                  @db.VarChar(80)
  condition             stock_condition_enum     @default(good)

  // Balance snapshot (before/after for audit trail)
  qty_before            Decimal?                 @db.Decimal(18, 4)
  qty_after             Decimal?                 @db.Decimal(18, 4)
  avg_cost_before       Decimal?                 @db.Decimal(18, 4)
  avg_cost_after        Decimal?                 @db.Decimal(18, 4)

  // Source document line reference
  reference_item_type   String?                  @db.VarChar(60)
  reference_item_id     String?                  @db.Uuid

  notes                 String?
  sort_order            Int                      @default(0)
  created_at            DateTime                 @default(now()) @db.Timestamptz(6)
  created_by_user_id    String?                  @db.Uuid

  // Relations
  transaction           inventory_transactions   @relation(fields: [transaction_id], references: [id], onDelete: Cascade)
  product_variants      product_variants         @relation(fields: [product_variant_id], references: [id], onDelete: Restrict)
  stock_balances        stock_balances?          @relation(fields: [stock_balance_id], references: [id], onDelete: SetNull)

  @@index([transaction_id], map: "idx_inv_txn_item_txn")
  @@index([tenant_id, product_variant_id], map: "idx_inv_txn_item_variant")
  @@index([stock_balance_id], map: "idx_inv_txn_item_balance")
  @@index([batch_id], map: "idx_inv_txn_item_batch")
  @@index([serial_id], map: "idx_inv_txn_item_serial")
}

/// Immutable audit trail for all inventory mutations.
model inventory_audit_logs {
  id                    String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id             String                   @db.Uuid
  transaction_id        String?                  @db.Uuid
  action                String                   @db.VarChar(50)
  entity_type           String                   @db.VarChar(100)
  entity_id             String                   @db.VarChar(100)
  old_values            Json?
  new_values            Json?
  metadata              Json?
  user_id               String?                  @db.Uuid
  ip_address            String?                  @db.VarChar(45)
  user_agent            String?
  idempotency_key       String?                  @db.VarChar(128)
  created_at            DateTime                 @default(now()) @db.Timestamptz(6)

  // Relations
  transaction           inventory_transactions?  @relation(fields: [transaction_id], references: [id], onDelete: SetNull)

  @@index([tenant_id, created_at(sort: Desc)], map: "idx_inv_audit_tenant_created")
  @@index([transaction_id], map: "idx_inv_audit_txn")
  @@index([entity_type, entity_id], map: "idx_inv_audit_entity")
}

// =============================================================================
// POS RUNTIME MODELS
// =============================================================================

enum held_order_status_enum {
  held
  resumed
  cancelled
}

/// Cashier authorization mapping for POS terminals.
model pos_terminal_users {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id          String        @db.Uuid
  terminal_id        String        @db.Uuid
  user_id            String        @db.Uuid
  is_active          Boolean       @default(true)
  created_at         DateTime      @default(now()) @db.Timestamptz(6)
  updated_at         DateTime      @default(now()) @db.Timestamptz(6)
  created_by_user_id String?       @db.Uuid
  updated_by_user_id String?       @db.Uuid

  // Relations
  terminal           pos_terminals @relation(fields: [terminal_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([terminal_id, user_id])
  @@index([tenant_id])
  @@index([user_id])
}

/// Represents a cashier shift/session on a POS terminal.
model pos_sessions {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id          String              @db.Uuid
  terminal_id        String              @db.Uuid
  cashier_id         String              @db.Uuid
  status             session_status_enum @default(open)
  opening_cash       Decimal             @default(0) @db.Decimal(18, 4)
  expected_cash      Decimal             @default(0) @db.Decimal(18, 4)
  actual_cash        Decimal?            @db.Decimal(18, 4)
  cash_difference    Decimal?            @db.Decimal(18, 4)
  opened_at          DateTime            @default(now()) @db.Timestamptz(6)
  closed_at          DateTime?           @db.Timestamptz(6)
  notes              String?
  created_at         DateTime            @default(now()) @db.Timestamptz(6)
  updated_at         DateTime            @default(now()) @db.Timestamptz(6)
  created_by_user_id String?             @db.Uuid
  updated_by_user_id String?             @db.Uuid

  // Relations
  terminal           pos_terminals       @relation(fields: [terminal_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  pos_cash_movements pos_cash_movements[]
  pos_held_orders    pos_held_orders[]
  sales_orders       sales_orders[]
  sales_order_payments sales_order_payments[]

  @@index([tenant_id])
  @@index([terminal_id])
  @@index([cashier_id])
  @@index([tenant_id, status])
}

/// Audit trail for all cash drawer movements within a POS session.
model pos_cash_movements {
  id                 String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id          String                    @db.Uuid
  session_id         String                    @db.Uuid
  type               cash_movement_type_enum   @default(in)
  reason             cash_movement_reason_enum @default(sale)
  amount             Decimal                   @default(0) @db.Decimal(18, 4)
  reference_type     String?                   @db.VarChar(50)
  reference_id       String?                   @db.Uuid
  notes              String?
  created_at         DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at         DateTime                  @default(now()) @db.Timestamptz(6)
  created_by_user_id String?                   @db.Uuid
  updated_by_user_id String?                   @db.Uuid

  // Relations
  session            pos_sessions              @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([session_id])
  @@index([tenant_id])
}

/// Individual payment records supporting split/mixed payments for sales orders.
model sales_order_payments {
  id                 String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id          String                    @db.Uuid
  sales_order_id     String                    @db.Uuid
  session_id         String?                   @db.Uuid
  payment_method     payment_method_type_enum  @default(cash)
  amount             Decimal                   @default(0) @db.Decimal(18, 4)
  currency           String                    @default("USD") @db.Char(3)
  status             payment_status_enum       @default(completed)
  reference_number   String?                   @db.VarChar(100)
  notes              String?
  created_at         DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at         DateTime                  @default(now()) @db.Timestamptz(6)
